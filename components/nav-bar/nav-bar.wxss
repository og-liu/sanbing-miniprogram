.nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 900;
  background: #f3f1ea;
}

.nav__bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.nav__title {
  color: #141b21;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.nav__spacer {
  width: 100%;
}
