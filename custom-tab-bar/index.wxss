.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  border-top: 1rpx solid #ddd9cf;
  background: #f3f1ea;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar__inner {
  display: flex;
  width: 100%;
  max-width: 720px;
  height: 116rpx;
  margin: 0 auto;
}

.tabbar__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #6d767f;
  transition: background-color 0.16s ease;
}

.tabbar__tick {
  width: 28rpx;
  height: 2rpx;
  margin-bottom: 11rpx;
  background: transparent;
  opacity: 0;
  transform: scaleX(0.4);
  transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
}

.tabbar__label {
  font-size: 23rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  line-height: 1;
  transition: color 0.2s ease;
}

.tabbar__en {
  margin-top: 7rpx;
  color: #9ba1a7;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  font-size: 13rpx;
  letter-spacing: 1rpx;
  line-height: 1;
  transition: color 0.2s ease;
}

.tabbar__item--active .tabbar__tick {
  background: #255f59;
  opacity: 1;
  transform: scaleX(1);
}

.tabbar__item--active .tabbar__label {
  color: #141b21;
  font-weight: 600;
}

.tabbar__item--active .tabbar__en {
  color: #255f59;
}

.tabbar__item--hover {
  background: #ece9e0;
}

@media (prefers-reduced-motion: reduce) {
  .tabbar__item,
  .tabbar__tick,
  .tabbar__label,
  .tabbar__en {
    transition: none;
  }
}
