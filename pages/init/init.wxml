<!-- 角色初始化：分区表单 -->
<view class="page">
  <view class="page-head">
    <view class="eyebrow-row">
      <text class="eyebrow">STEP 02 / CHARACTER SETUP</text>
      <text class="eyebrow-note">INITIALIZATION</text>
    </view>
    <view class="step-track">
      <view class="step-track__fill step-track__fill--full"></view>
    </view>
    <text class="page-title">建立你的角色档案</text>
    <text class="page-subtitle">先写下游戏里的身份，再按下保存。之后每次回来，档案都会自动恢复。</text>
  </view>

  <block wx:if="{{guardLoading}}">
    <view class="state-card sb-card">
      <view class="state-spinner"></view>
      <text class="state-title">正在读取账号状态</text>
      <text class="state-copy">请稍候，我们正在确认你的初始化进度</text>
    </view>
  </block>

  <block wx:elif="{{guardError}}">
    <view class="state-card sb-card">
      <view class="state-icon">!</view>
      <text class="state-title">加载失败</text>
      <text class="state-copy">{{guardError}}</text>
      <button
        class="sb-secondary"
        hover-class="button-hover"
        bindtap="loadGuard"
      >重新加载</button>
    </view>
  </block>

  <block wx:else>
    <view class="form-sheet sb-card">
        <view class="form-section">
          <view class="section-head">
            <text class="section-index">01</text>
            <text class="section-title">基础身份</text>
            <text class="section-meta">IDENTITY</text>
          </view>

          <view class="field field--first">
            <view class="label-row">
              <text class="field-label">游戏昵称</text>
              <text class="required-mark">必填</text>
            </view>
            <view class="sb-control {{fieldErrors.gameNickname ? 'input-shell--error' : ''}}">
              <input
                id="gameNicknameInput"
                class="sb-input"
                type="text"
                value="{{gameNickname}}"
                maxlength="30"
                placeholder="请输入你在游戏中的昵称"
                placeholder-class="input-placeholder"
                bindinput="onNicknameInput"
                cursor-spacing="24"
              />
            </view>
            <text class="field-help">与微信昵称分开保存，请填写游戏内实际昵称</text>
            <text wx:if="{{fieldErrors.gameNickname}}" class="field-error">{{fieldErrors.gameNickname}}</text>
          </view>

          <view class="field">
            <view class="label-row">
              <text class="field-label">性别</text>
              <text class="required-mark">必填</text>
            </view>
            <view class="gender-options">
              <view
                id="genderMale"
                class="gender-option {{gender === 'male' ? 'gender-option--active' : ''}}"
                hover-class="button-hover"
                data-gender="male"
                bindtap="onGenderSelect"
              >
                <view class="gender-indicator"></view>
                <text>男</text>
              </view>
              <view
                id="genderFemale"
                class="gender-option {{gender === 'female' ? 'gender-option--active' : ''}}"
                hover-class="button-hover"
                data-gender="female"
                bindtap="onGenderSelect"
              >
                <view class="gender-indicator"></view>
                <text>女</text>
              </view>
              <view
                id="genderSecret"
                class="gender-option {{gender === 'secret' ? 'gender-option--active' : ''}}"
                hover-class="button-hover"
                data-gender="secret"
                bindtap="onGenderSelect"
              >
                <view class="gender-indicator"></view>
                <text>保密</text>
              </view>
            </view>
            <text class="field-help">请主动选择，我们不会根据其他信息推断</text>
            <text wx:if="{{fieldErrors.gender}}" class="field-error">{{fieldErrors.gender}}</text>
          </view>
        </view>

        <view class="form-section">
          <view class="section-head">
            <text class="section-index">02</text>
            <text class="section-title">战力指数</text>
            <text class="section-meta">POWER</text>
          </view>

          <view class="field field--first">
            <view class="label-row">
              <text class="field-label">当前总战力</text>
              <text class="required-mark">必填</text>
            </view>
            <view class="sb-control {{fieldErrors.totalPower ? 'input-shell--error' : ''}}">
              <input
                id="totalPowerInput"
                class="sb-input text-input--number"
                type="number"
                value="{{totalPower}}"
                maxlength="12"
                placeholder="请输入当前总战力"
                placeholder-class="input-placeholder"
                bindinput="onPowerInput"
                cursor-spacing="24"
              />
              <text class="input-suffix">POWER</text>
            </view>
            <text class="field-help">仅支持整数，无需填写逗号或单位</text>
            <text wx:if="{{fieldErrors.totalPower}}" class="field-error">{{fieldErrors.totalPower}}</text>
          </view>
        </view>

        <view wx:if="{{formError}}" class="form-error">
          <text class="form-error-mark">!</text>
          <text class="form-error-text">{{formError}}</text>
        </view>

        <button
          id="initSubmitButton"
          class="sb-primary {{submitting ? 'sb-primary--disabled' : ''}}"
          hover-class="button-hover"
          disabled="{{submitting}}"
          bindtap="onSubmit"
        >{{submitting ? '正在保存…' : '保存并进入个人中心'}}</button>

        <text class="form-note">资料将保存至云端，再次登录会自动恢复</text>
    </view>

    <view class="org-note sb-note">
      <view class="org-note-head">
        <view class="org-note-icon"></view>
        <text class="org-note-title">ORGANIZATION / 关于组织信息</text>
      </view>
      <text class="org-note-copy">当前无需填写区服、同盟和同盟阶级。初始化后，个人中心会先显示“暂未加入”状态，组织功能将在后续版本开放。</text>
    </view>
  </block>
</view>
