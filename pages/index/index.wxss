  display: block;
  margin-top: 12rpx;
  color: var(--sb-text-muted);
  font-size: 25rpx;
  letter-spacing: 1rpx;
}

.launch-line {
  width: 180rpx;
  height: 2rpx;
  margin-top: 44rpx;
  overflow: hidden;
  background: var(--sb-line);
}

.launch-line__fill {
  width: 42%;
  height: 100%;
  background: var(--sb-accent);
  animation: launch-line 1.2s var(--sb-ease) infinite;
}

.launch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--sb-line);
  color: var(--sb-text-faint);
  font-family: var(--sb-font-mono);
  font-size: 16rpx;
  letter-spacing: 1rpx;
}

@keyframes launch-line {
  0% {
    transform: translateX(-110%);
  }
  100% {
    transform: translateX(340%);
  }
}

.login-page {
    padding-right: 48rpx;
    padding-left: 48rpx;
  }

  .login-main {
    flex-direction: row;
    align-items: flex-start;
    gap: 56rpx;
    padding-top: 94rpx;
  }

  .login-copy {
    flex: 1.06;
  }

  .display {
    font-size: 82rpx;
  }

  .auth-panel {
    flex: 0.94;
    margin-top: 8rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .login-top,
  .login-copy,
  .auth-panel,
  .login-footer,
  .spinner,
  .auth-marker--active {
    animation: none;
  }
}
