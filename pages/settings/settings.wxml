<view class="page settings-page">
  <view class="page-head">
    <text class="eyebrow">SETTINGS / ACCOUNT</text>
    <text class="page-title">设置</text>
    <text class="page-subtitle">账号、数据与当前登录状态。</text>
  </view>

  <view class="settings-group">
    <text class="settings-kicker">ACCOUNT</text>
    <view class="settings-row">
      <text class="settings-label">微信身份</text>
      <text class="settings-value">已绑定当前微信</text>
    </view>
    <view class="settings-row settings-row--action" hover-class="button-hover" bindtap="onEditWechatProfile">
      <text class="settings-label">微信资料</text>
      <view class="settings-action">
        <text class="settings-value">头像与昵称</text>
        <text class="settings-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="settings-group">
    <text class="settings-kicker">APPLICATION</text>
    <view class="settings-row">
      <text class="settings-label">版本</text>
      <text class="settings-value">V2.0 / 2026</text>
    </view>
  </view>

  <view class="settings-group">
    <text class="settings-kicker">DATA</text>
    <view class="settings-row settings-row--action">
      <text class="settings-label">注销账户</text>
      <view class="settings-button" hover-class="button-hover" bindtap="onResetProfile">注销</view>
    </view>
    <text class="settings-note">清空微信资料、角色资料与头像，回到首次进入</text>
  </view>

  <view class="settings-group settings-group--last">
    <text class="settings-kicker">SESSION</text>
    <view class="settings-row settings-row--action" hover-class="button-hover" bindtap="onSignOut">
      <text class="settings-label">退出登录</text>
      <view class="settings-action">
        <text class="settings-value">仅退出本机</text>
        <text class="settings-arrow">→</text>
      </view>
    </view>
    <text class="settings-note">不会解除微信身份或删除云端档案</text>
  </view>
</view>
