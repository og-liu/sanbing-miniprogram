<page-meta page-style="background-color: #f3f1ea;" />
<view class="profile-shell">
  <nav-bar title="个人中心" />
  <scroll-view
    class="profile-scroll"
    scroll-y
    refresher-enabled
    refresher-background="#f3f1ea"
    refresher-default-style="black"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="page {{tabEntering ? 'page--enter' : ''}}">
  <block wx:if="{{loading}}">
    <view class="state-screen">
      <view class="state-spinner"></view>
      <text class="state-title">正在加载个人资料</text>
      <text class="state-copy">正在从云端恢复你的账号信息</text>
    </view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="state-screen">
      <view class="state-icon">!</view>
      <text class="state-title">资料加载失败</text>
      <text class="state-copy">{{loadError}}</text>
      <button
        id="profileRetryButton"
        class="sb-secondary"
        hover-class="button-hover"
        bindtap="onRetryProfile"
      >重新加载</button>
    </view>
  </block>

  <block wx:else>
    <view class="ice-sigil ice-sigil--profile" aria-hidden="true">
      <view class="ice-sigil__ring ice-sigil__ring--outer"></view>
      <view class="ice-sigil__ring ice-sigil__ring--inner"></view>
      <view class="ice-sigil__diamond"></view>
      <view class="ice-sigil__axis ice-sigil__axis--h"></view>
      <view class="ice-sigil__axis ice-sigil__axis--v"></view>
      <view class="ice-sigil__core"></view>
    </view>

    <view class="profile-head">
      <view class="profile-meta">
        <text class="eyebrow">OPERATOR / 个人中心</text>
        <view class="sync-state">
          <view class="sync-dot"></view>
          <text>CLOUD SYNCED</text>
        </view>
      </view>

      <view class="identity-row">
        <view class="avatar-frame">
          <image
            wx:if="{{avatarSrc}}"
            class="avatar-image"
            src="{{avatarSrc}}"
            mode="aspectFill"
            binderror="onAvatarError"
          />
          <view wx:else class="avatar-placeholder">
            <view class="avatar-head"></view>
            <view class="avatar-body"></view>
          </view>
        </view>

        <view class="identity-main">
          <text class="wechat-label">WECHAT ID</text>
          <text class="wechat-name">{{hasWechatNickname ? wechatNickname : '未设置微信昵称'}}</text>
          <text wx:if="{{avatarError}}" class="wechat-state wechat-state--warn">头像加载失败，请在设置中重新设置</text>
          <text wx:elif="{{hasWechatAvatar}}" class="wechat-state">微信身份已验证</text>
          <text wx:else class="wechat-state">尚未设置微信头像</text>
        </view>

        <view
          id="settingsEntry"
          class="settings-link"
          hover-class="button-hover"
          bindtap="openSettings"
        >设置<text class="settings-arrow">→</text></view>
      </view>

      <view wx:if="{{!wechatProfileComplete}}" class="incomplete-banner">
        <view class="incomplete-copy">
          <text class="incomplete-title">微信资料尚未完善</text>
          <text class="incomplete-text">头像与昵称可由你主动选择</text>
        </view>
        <button
          id="completeWechatProfile"
          class="incomplete-button"
          hover-class="button-hover"
          bindtap="openWechatProfilePage"
        >去完善</button>
      </view>
    </view>

    <view class="profile-body">
      <view class="power-panel">
        <view class="power-head">
          <text class="power-label">TOTAL POWER / 当前总战力</text>
          <text class="power-mark">PWR</text>
        </view>
        <text class="power-value">{{totalPowerDisplay}}</text>
      </view>

      <view class="profile-info">
      <view class="info-section">
        <view class="info-head">
          <view class="info-title-wrap">
            <text class="info-index">01</text>
            <view class="info-title-copy">
              <text class="info-title">基础信息</text>
              <text class="info-meta">BASIC INFO</text>
            </view>
          </view>
          <view class="info-edit" hover-class="button-hover" data-section="basic" bindtap="openGameProfileEditor">
            <text>编辑</text>
            <text class="info-edit-arrow">→</text>
          </view>
        </view>
        <view class="info-grid">
          <view class="info-cell">
            <text class="info-label">游戏昵称</text>
            <text class="info-value">{{gameNickname}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">性别</text>
            <text class="info-value">{{genderLabel}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">所属区服</text>
            <text class="info-value">{{organizationServerText}}</text>
          </view>
          <view class="info-cell">
            <text class="info-label">所属同盟</text>
            <text class="info-value">{{organizationGuildText}}</text>
          </view>
        </view>
      </view>

      <view class="info-section">
        <view class="info-head">
          <view class="info-title-wrap">
            <text class="info-index">02</text>
            <view class="info-title-copy">
              <text class="info-title">核心属性</text>
              <text class="info-meta">CORE ATTRIBUTES</text>
            </view>
          </view>
          <view class="info-edit" hover-class="button-hover" data-section="core" bindtap="openGameProfileEditor">
            <text>编辑</text>
            <text class="info-edit-arrow">→</text>
          </view>
        </view>
        <view class="info-grid">
          <view
            wx:for="{{coreAttributeItems}}"
            wx:key="key"
            class="info-cell {{index === coreAttributeItems.length - 1 ? 'info-cell--wide' : ''}}"
          >
            <text class="info-label">{{item.label}}</text>
            <view class="info-value-row">
              <text class="info-number">{{item.display}}</text>
              <text wx:if="{{item.hasValue && item.unit}}" class="info-unit">{{item.unit}}</text>
            </view>
          </view>
        </view>
      </view>
      </view>
    </view>

    <view class="page-foot">
      <view class="data-state">
        <view class="data-state-dot"></view>
        <text>资料已同步至云端</text>
      </view>
      <text class="page-foot-note">组织功能将在后续版本开放 · 下拉可刷新资料</text>
    </view>
  </block>
    </view>
  </scroll-view>
</view>
