.edit-page {
  padding: 0 var(--sb-page-gutter) calc(48rpx + env(safe-area-inset-bottom));
}

.edit-sheet {
  margin-top: 28rpx;
  padding: 30rpx 28rpx 26rpx;
}

.section-head {
  display: flex;
  align-items: center;
  padding-bottom: 4rpx;
}

.section-index {
  color: var(--sb-accent);
  font-family: var(--sb-font-mono);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.section-title {
  margin-left: 12rpx;
  color: var(--sb-text-strong);
  font-size: 28rpx;
  font-weight: 600;
}

.section-meta {
  margin-left: auto;
  color: var(--sb-text-faint);
  font-family: var(--sb-font-mono);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.text-input--number {
  font-family: var(--sb-font-mono);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

.input-suffix {
  margin-left: 14rpx;
  color: var(--sb-text-faint);
  font-family: var(--sb-font-mono);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.gender-options {
  display: flex;
  margin-top: 14rpx;
}

.gender-option {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin-right: 12rpx;
  border: 1rpx solid var(--sb-line);
  border-radius: var(--sb-radius-control);
  background: var(--sb-control-bg);
  color: var(--sb-text-muted);
  font-size: 27rpx;
  transition: border-color 0.18s var(--sb-ease),
    background-color 0.18s var(--sb-ease), color 0.18s var(--sb-ease);
}

.gender-option:last-child {
  margin-right: 0;
}

.gender-option--active {
  border-color: var(--sb-accent);
  background: var(--sb-accent-soft);
  color: var(--sb-accent-strong);
  font-weight: 600;
}

.gender-indicator {
  width: 18rpx;
  height: 18rpx;
  margin-right: 10rpx;
  border: 2rpx solid var(--sb-line-strong);
  border-radius: 50%;
}

.gender-option--active .gender-indicator {
  border: 5rpx solid var(--sb-accent);
  background: var(--sb-surface);
}

.attribute-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx 20rpx;
  margin-top: 20rpx;
}

.attribute-field {
  min-width: 0;
}

.attribute-field:last-child {
  grid-column: 1 / -1;
}

.attribute-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.attribute-optional {
  color: var(--sb-text-faint);
  font-size: 20rpx;
}

.form-note {
  display: block;
  margin-top: 16rpx;
  color: var(--sb-text-faint);
  font-size: 22rpx;
  text-align: center;
}
